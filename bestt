                request_id = c.lastrowid
                
                print(f"✅ DEBUG: Friend request saved to database (ID: {request_id})")
                
                # Notify receiver if online
                if receiver_username in active_connections:
                    print(f"✅ DEBUG: Receiver {receiver_username} is online, sending notification...")
                    try:
                        await active_connections[receiver_username].send(json.dumps({
                            'type': 'friend_request_received',
                            'from': sender_username,
                            'from_id': sender[0],
                            'to': receiver_username,
                            'to_id': receiver[0],
                            'request_id': request_id,
                            'timestamp': datetime.now().isoformat()
