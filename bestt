        conn.close()

async def handle_accept_friend_request(data, accepter_username):
    """Handle accepting a friend request"""
    from_id = data.get('from_id')  # This is the user who sent the request
    
    conn = sqlite3.connect('p2p_chat.db')
    c = conn.cursor()
    
    try:
        # Get accepter's user ID
        c.execute('SELECT id FROM users WHERE username = ?', (accepter_username,))
        accepter = c.fetchone()
        
        if not accepter:
            return
        
        # Get the friend request
        c.execute('''
            SELECT fr.id, fr.sender_id, fr.receiver_id, u.username 
            FROM friend_requests fr
            JOIN users u ON fr.sender_id = u.id
            WHERE fr.sender_id = ? AND fr.receiver_id = ? AND fr.status = 'pending'
        ''', (from_id, accepter[0]))
        request = c.fetchone()
        
        if request:

            request_id, sender_id, receiver_id, sender_username = request
            
            # Update request status
            c.execute('UPDATE friend_requests SET status = "accepted" WHERE id = ?', (request_id,))
            
            # Create friendship (ensure user1_id < user2_id)
            user1_id = min(sender_id, receiver_id)
            user2_id = max(sender_id, receiver_id)
            
            c.execute('''
                INSERT OR IGNORE INTO friendships (user1_id, user2_id)
                VALUES (?, ?)
            ''', (user1_id, user2_id))
            
            conn.commit()
            
            # Get sender's username for notification
            c.execute('SELECT username FROM users WHERE id = ?', (sender_id,))
            sender_username = c.fetchone()[0]
            
            # Notify both users
            notification = {
                'type': 'friend_request_accepted',
                'user_id': accepter[0],
                'username': accepter_username,
                'friend_id': sender_id,
                'friend_username': sender_username,
                'timestamp': datetime.now().isoformat()
            }
            
            # Notify sender
            if sender_username in active_connections:
                try:
                    await active_connections[sender_username].send(json.dumps(notification))
                except:
                    print(f"Failed to notify {sender_username} about accepted request")
            
            # Notify receiver (accepter)
            if accepter_username in active_connections:
                try:
                    await active_connections[accepter_username].send(json.dumps({
                        'type': 'friend_request_accepted',
                        'user_id': sender_id,
                        'username': sender_username,
                        'friend_id': accepter[0],
                        'friend_username': accepter_username,
                        'timestamp': datetime.now().isoformat()
                    }))
                except:
                    print(f"Failed to notify {accepter_username} about accepted request")
    except Exception as e:
        print(f"Error in handle_accept_friend_request: {e}")
    finally:
        conn.close()

