async def handle_group_message(data, websocket, sender_username):
    group_id = data.get('group_id')
    message_text = data.get('message')
    client_id = data.get('client_id')
    
    if not group_id or not message_text:
        return

    conn = sqlite3.connect('p2p_chat.db')
    c = conn.cursor()
    
    # Get sender ID
    c.execute('SELECT id FROM users WHERE username = ?', (sender_username,))
    sender = c.fetchone()
    
    if not sender:
        conn.close()
        return

    # Verify sender is in group
    c.execute('SELECT 1 FROM group_members WHERE group_id = ? AND user_id = ?', (group_id, sender[0]))
    is_member = c.fetchone()
    
    if not is_member:
        conn.close()
        return

    # Save message to database
    c.execute('''
        INSERT INTO messages (sender_id, group_id, message, message_type)
        VALUES (?, ?, ?, ?)
    ''', (sender[0], group_id, message_text, 'text'))
    conn.commit()
    message_id = c.lastrowid
    
    # Get all group members to broadcast to
    c.execute('''
        SELECT u.username 
        FROM group_members gm
        JOIN users u ON gm.user_id = u.id
        WHERE gm.group_id = ?
    ''', (group_id,))
    members = c.fetchall()
    
    conn.close()

    payload = {
        'type': 'group_message',
        'id': message_id,
        'client_id': client_id,
        'from': sender_username,
        'from_id': sender[0],
        'group_id': group_id,
        'message': message_text,
        'timestamp': datetime.now().isoformat()
    }

    # Broadcast to all members
    for member in members:
        member_username = member[0]
        if member_username != sender_username and member_username in active_connections:
            try:
                await active_connections[member_username].send(json.dumps(payload))
            except:
                pass

    # Send ack to sender
    try:
        ack = {
            'type': 'delivery_ack', 
            'client_id': client_id, 
            'message_id': message_id, 
            'to_id': group_id 
        }
        await websocket.send(json.dumps(ack))
    except Exception:
        pass



async def handle_get_group_messages(data, websocket, username):
    """Send group message history to the requesting user"""
    group_id = data.get('group_id')
    if not group_id:
        return

    conn = sqlite3.connect('p2p_chat.db')
    c = conn.cursor()
    
    try:
        # Get user ID
        c.execute('SELECT id FROM users WHERE username = ?', (username,))
        user_row = c.fetchone()
        if not user_row:
            return
        user_id = user_row[0]

        # Verify membership
        c.execute('SELECT 1 FROM group_members WHERE group_id = ? AND user_id = ?', (group_id, user_id))
        if not c.fetchone():
            return

        # Fetch messages
        c.execute('''
            SELECT m.id, m.sender_id, m.message, m.timestamp, u.username
            FROM messages m
            JOIN users u ON m.sender_id = u.id
            WHERE m.group_id = ?
            ORDER BY m.timestamp ASC
            LIMIT 50
        ''', (group_id,))
        
        messages = []
        for row in c.fetchall():
            messages.append({
                'id': row[0],
                'sender_id': row[1],
                'message': row[2],
                'timestamp': row[3],
                'sender_username': row[4],
                'group_id': group_id,
                'is_outgoing': (row[4] == username)
            })
            
        await websocket.send(json.dumps({
            'type': 'group_history',
            'group_id': group_id,
            'messages': messages
        }))

    except Exception as e:
        print(f"Error fetching group messages: {e}")
    finally:
        conn.close()



async def handle_get_groups(websocket, username):
    """Send list of groups the user belongs to"""
    conn = sqlite3.connect('p2p_chat.db')
    c = conn.cursor()
    
    try:
        # Get user ID
        c.execute('SELECT id FROM users WHERE username = ?', (username,))
        user_row = c.fetchone()
        if not user_row:
            return
        user_id = user_row[0]

        # Fetch groups
        c.execute('''
            SELECT g.id, g.name
            FROM groups g
            JOIN group_members gm ON g.id = gm.group_id
            WHERE gm.user_id = ?
        ''', (user_id,))
        
        groups_list = []
        for row in c.fetchall():
            g_id = row[0]
            g_name = row[1]
            # Fetch members for this group
            c.execute('''
                SELECT u.username 
                FROM users u
                JOIN group_members gm ON u.id = gm.user_id
                WHERE gm.group_id = ?
            ''', (g_id,))
            members = [r[0] for r in c.fetchall()]
            
            groups_list.append({
                'id': g_id,
                'name': g_name,
                'members': members
            })
            
        await websocket.send(json.dumps({
            'type': 'group_list',
            'groups': groups_list
        }))

    except Exception as e:
        print(f"Error fetching groups: {e}")
    finally:
        conn.close()


