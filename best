        function handleIncomingFriendRequest(data) {
            const request = {
                id: data.request_id,
                from_id: data.from_id,
                from_username: data.from,
                to_id: data.to_id,
                to_username: data.to,
                timestamp: data.timestamp,
                status: 'pending'
            };

            friendRequests.incoming.push(request);
            saveFriendRequests();
            renderFriendRequests();

            // Show notification
            showNotificationWithSound(`New friend request from ${data.from}`, 'info', true);
        }

        function handleFriendRequestAccepted(data) {
            // Find and remove from outgoing requests
            const requestIndex = friendRequests.outgoing.findIndex(req => req.id === data.request_id);
            if (requestIndex !== -1) {
                const request = friendRequests.outgoing[requestIndex];

                // Add to friends
                const newFriend = {
                    user_id: request.to_id,
                    username: request.to_username,
                    is_online: true,
                    last_seen: new Date().toISOString(),
                    friendship_date: new Date().toISOString()
                };

                friends.push(newFriend);
                saveFriends();

                // Remove from outgoing
                friendRequests.outgoing.splice(requestIndex, 1);
                saveFriendRequests();

                // Update UI
                renderFriendsList();
                renderFriendRequests();

                // Initialize chat history
                initializeFriendChatHistory(request.to_id);

                showNotification(`${request.to_username} accepted your friend request!`, 'success');
            }
        }

        function handleFriendRequestRejected(data) {
            // Remove from outgoing requests
            const requestIndex = friendRequests.outgoing.findIndex(req => req.id === data.request_id);
            if (requestIndex !== -1) {
                friendRequests.outgoing.splice(requestIndex, 1);
                saveFriendRequests();
                renderFriendRequests();

                showNotification(`Friend request to ${data.to} was rejected`, 'info');
            }
        }

        function handleFriendRequestCancelled(data) {
            // Remove from incoming requests
            const requestIndex = friendRequests.incoming.findIndex(req => req.id === data.request_id);
            if (requestIndex !== -1) {
                friendRequests.incoming.splice(requestIndex, 1);
                saveFriendRequests();
